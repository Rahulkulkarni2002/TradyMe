# ─────────────────────────────────────────────────────────────
#  TradyMe private settings.
#  1) Copy this file and name the copy  .env   (just ".env", nothing before the dot)
#  2) Fill in the keys you have. Leave the rest empty.
#  .env is in .gitignore → it NEVER goes to GitHub. Never share these keys with anyone.
# ─────────────────────────────────────────────────────────────

# ── Alpaca (💰 Live mode, crypto) ── https://app.alpaca.markets → Paper account → API Keys → Generate
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true  = Alpaca PRACTICE account (fake money)  ← start here
# false = REAL money (only when you're ready, and use your LIVE account's keys)
ALPACA_PAPER=true

# ── OANDA practice (optional: better forex data) ── https://www.oanda.com → demo account → Manage API Access
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# ── Telegram alerts (coming soon) ── create a bot with @BotFather, get your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
